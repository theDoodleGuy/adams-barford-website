---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import AreasStrip from '../components/AreasStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import copy from '../data/copy.json';
import { img } from '../data/images';
import { settings, phoneDisplay, telHref } from '../lib/site';
import { getServices, getServiceLabels, getProjects, getReviews } from '../lib/content';

const home = copy.home;
const services = await getServices();
const labels = await getServiceLabels();
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const reviews = (await getReviews()).slice(0, 3);
const years = new Date().getFullYear() - settings.founded;
---
<BaseLayout
  title="Builders in Hythe & the New Forest | Adams & Barford, since 1995"
  description={settings.oneLiner}
  image={img('shoot050')}
>
  <!-- Hero: content is visible from first paint, no entrance animation (review finding C4). -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">{home.heroEyebrow}</p>
        <h1 id="hero-title" class="hero__title">{home.heroTitle}</h1>
        <p class="hero__lead">{home.heroLead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">{home.heroCtaPrimary}</a>
          <a class="btn btn--secondary" href="/our-work/">{home.heroCtaSecondary}</a>
        </div>
        <p class="hero__phone">
          Prefer to talk? <a href={telHref}><PhoneIcon size={16} /> {phoneDisplay}</a>
        </p>
      </div>
      <div class="hero__media">
        <Img
          src="shoot050"
          alt="One of the Adams & Barford team finishing the landscaping outside a new brick house with an oak-framed porch"
          eager
          sizes="(min-width: 1240px) 640px, (min-width: 900px) 52vw, 100vw"
        />
        <p class="hero__badge" aria-hidden="true"><strong>Since {settings.founded}</strong><span>Family-run in Hythe</span></p>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Why people choose us">
    <div class="container">
      <ul class="trust-list">
        {home.trustPoints.map((t) => (
          <li>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M7 12.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <div>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2 id="services-title">{home.servicesTitle}</h2>
          <p class="lead mb-0">{home.servicesLead}</p>
        </div>
        <a class="text-link" href="/services/">All our services</a>
      </div>
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section
    class="section section--sand difference difference--pattern"
    aria-labelledby="difference-title"
    style={`--pattern: url('${img('ampersandPattern')}')`}
  >
    <div class="container split">
      <div class="difference__media">
        <Img src="shoot041" alt="Members of the Adams & Barford team sharing a joke in their Hythe office" sizes="(min-width: 900px) 560px, 100vw" widths={[480, 800, 1120]} />
      </div>
      <div>
        <h2 id="difference-title">{home.differenceTitle}</h2>
        <p class="lead">{home.differenceLead}</p>
        <ul class="point-list">
          {home.differencePoints.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6 mb-0"><a class="text-link" href="/about/">Meet the family behind the firm</a></p>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <h2 id="work-title">{home.workTitle}</h2>
            <p class="lead mb-0">{home.workLead}</p>
          </div>
          <a class="text-link" href="/our-work/">See all our work</a>
        </div>
        <div class="grid grid--3">
          {featured.map((p) => <ProjectCard project={p} serviceLabel={labels[p.data.service]} />)}
        </div>
      </div>
    </section>
  )}

  <ReviewsSection title={home.reviewsTitle} reviews={reviews} labels={labels} sand />

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2 id="process-title">{home.processTitle}</h2>
          <p class="lead mb-0">{home.processLead}</p>
        </div>
        <a class="text-link" href="/about/#how-we-work">More about how we work</a>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <AreasStrip />

  <CtaBand />
</BaseLayout>
