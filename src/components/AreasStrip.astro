---
import { settings } from '../lib/site';
interface Props { title?: string; lead?: string; showLink?: boolean; sand?: boolean; }
const {
  title = 'Where we work',
  lead = 'Based in Hythe, building across the Waterside, the New Forest and Southampton.',
  showLink = true,
  sand = true,
} = Astro.props;
---
<section class:list={['section section--tight', { 'section--sand': sand }]} aria-labelledby="areas-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <h2 id="areas-title">{title}</h2>
        <p class="lead mb-0">{lead}</p>
      </div>
      {showLink && <a class="text-link" href="/areas/">More about the areas we cover</a>}
    </div>
    <ul class="areas-list">
      {settings.areas.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>
