---
import copy from '../data/copy.json';
interface Props { headingLevel?: 'h3' | 'h4'; }
const { headingLevel: H = 'h3' } = Astro.props;
---
<ol class="process">
  {copy.process.map((s) => (
    <li>
      <span class="process__num" aria-hidden="true">{String(s.step).padStart(2, '0')}</span>
      <H><span class="visually-hidden">Step {s.step}: </span>{s.title}</H>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
